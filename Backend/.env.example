# Copy to .env and fill in. On Render, add the same keys under Environment.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/
MONGO_DB=accident_hotspot

# Comma-separated frontend URLs allowed to call the API (add your Vercel URL when deployed)
CORS_ORIGINS=http://localhost:5173

# ── Login ──
# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Hours before a user has to sign in again
JWT_EXPIRE_HOURS=12
# true = police sign-ups wait for an admin to approve them
REQUIRE_APPROVAL=true
# First admin account, created automatically on startup if it doesn't exist yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
